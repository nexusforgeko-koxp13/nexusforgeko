; AccessibleKeyboard.inf
; Root-enumerated WDM VHF keyboard and relative mouse driver.

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ManufacturerName%
CatalogFile = AccessibleKeyboard.cat
DriverVer   = 07/26/2026,1.1.2.0
PnpLockdown = 1

[DestinationDirs]
DriverCopyFiles = 13

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
AccessibleKeyboard.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...16299

[Standard.NTamd64.10.0...16299]
%DeviceDescription% = Device_Install, Root\NexusAccessibleKeyboard

[Device_Install.NT]
CopyFiles = DriverCopyFiles

[DriverCopyFiles]
AccessibleKeyboard.sys

[Device_Install.NT.HW]
AddReg = VhfLowerFilter_Add, Device_Security

[VhfLowerFilter_Add]
HKR,,"LowerFilters",0x00010000,"vhf"

[Device_Security]
HKR,,"Security",, "D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Device_Install.NT.Services]
AddService = AccessibleKeyboard,0x00000002,Service_Install

[Service_Install]
DisplayName    = %ServiceDisplayName%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\AccessibleKeyboard.sys

[Strings]
ManufacturerName   = "NexusForge"
DiskName           = "NexusForge Accessible Keyboard Installation Media"
DeviceDescription  = "NexusForge Accessible Input Control Driver"
ServiceDisplayName = "NexusForge Accessible Input Driver"
